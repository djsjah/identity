<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-11-06-002-indexes" author="mlops10">
        <sql dbms="postgresql">
            CREATE UNIQUE INDEX uk_users_email_upper
            ON users (UPPER(email));
        </sql>

        <createIndex tableName="user_version" indexName="idx_user_version_user_date">
            <column name="user_id"/>
            <column name="valid_from"/>
        </createIndex>

        <sql dbms="postgresql">
            CREATE UNIQUE INDEX uk_user_version_current
            ON user_version (user_id)
            WHERE valid_to IS NULL;
        </sql>

        <sql dbms="postgresql">
            CREATE UNIQUE INDEX uk_model_version_active
            ON model_version (is_active)
            WHERE is_active = TRUE;
        </sql>

        <createIndex tableName="image" indexName="idx_image_filepath">
            <column name="filepath"/>
        </createIndex>

        <createIndex tableName="image" indexName="idx_image_upload_date">
            <column name="upload_date"/>
        </createIndex>

        <createIndex tableName="verification_history" indexName="idx_verification_user">
            <column name="user_id"/>
        </createIndex>

        <createIndex tableName="verification_history" indexName="idx_verification_image">
            <column name="image_id"/>
        </createIndex>

        <createIndex tableName="verification_history" indexName="idx_verification_date">
            <column name="verification_date"/>
        </createIndex>

        <createIndex tableName="verification_history" indexName="idx_verification_result">
            <column name="result"/>
        </createIndex>

        <createIndex tableName="auth_session" indexName="idx_auth_session_user">
            <column name="user_id"/>
        </createIndex>

        <createIndex tableName="auth_session" indexName="idx_auth_session_expires_at">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
